-- ============================================================
-- ⚔️ TITLE SCREEN MODE (NO UI - TEXT STATUS ONLY)
-- ============================================================
-- ใส่ timeout ทุกตัว กันเธรดค้างตลอดกาลถ้าโครงสร้างเกมเปลี่ยน
local Assets = ReplicatedStorage:WaitForChild("Assets", 30)
local Remotes = Assets and Assets:WaitForChild("Remotes", 30)
local GET = Remotes and Remotes:WaitForChild("GET", 10)

local function StartAutoRoll()
    Status("Checking Gamepass & System...")

    if not GET then
        Status("ERROR: Remote GET not found!")
        return
    end

    task.wait(1)

    -- 🎫 เช็ค Gamepass แบบรอให้เสร็จจริง (ของเดิมรอแค่ 0.5 วิ บางทีเช็คไม่ทัน ทำให้นับ slot ขาด)
    local hasFamilyBag = false
    local gpDone = false
    task.spawn(function()
        pcall(function() hasFamilyBag = MarketplaceService:UserOwnsGamePassAsync(plr.UserId, 268079397) end)
        gpDone = true
    end)
    local gpWaited = 0
    while not gpDone and gpWaited < 8 do
        task.wait(0.25)
        gpWaited = gpWaited + 0.25
    end
    print("🎫 [Venoz] Gamepass FamilyBag: " .. tostring(hasFamilyBag))

    Status("Loading bag data from server...")

    local function getPriority(name)
        -- ใช้ plain find (ตัวสุดท้าย true) กันชื่อที่มีอักขระพิเศษทำ pattern พังแล้วเธรดตาย
        local upName = string.upper(name)
        local isTarget = false
        for _, target in ipairs(_G.TargetFamilies) do
            if string.find(upName, string.upper(tostring(target)), 1, true) then
                isTarget = true
                break
            end
        end
        if not isTarget then return 9999 end
        for i, master in ipairs(MasterPriorityList) do
            if string.find(upName, string.upper(master), 1, true) then return i end
        end
        return 9999
    end

    local function getBagInfo(data, activeSlot)
        local filledCount = 0
        local fams = {}
        local maxSlots = 1
        if hasFamilyBag then maxSlots = maxSlots + 10 end
        if data and data.Slots and data.Slots[activeSlot] then
            local extra = data.Slots[activeSlot].Extra_Slots
            if type(extra) == "number" then
                maxSlots = maxSlots + extra
            elseif type(extra) == "table" then
                if type(extra.Families) == "number" then
                    maxSlots = maxSlots + extra.Families
                elseif type(extra.Family) == "number" then
                    maxSlots = maxSlots + extra.Family
                end
            end
            local inventory = data.Slots[activeSlot].Inventory
            if inventory and type(inventory.Families) == "table" then
                for _, famName in ipairs(inventory.Families) do
                    if type(famName) == "string" and famName ~= "" and famName ~= "None" then
                        table.insert(fams, famName)
                    end
                end
                filledCount = #fams
            end
        end
        return maxSlots, filledCount, fams
    end

    -- 🎒 เก็บสถานะกระเป๋า + จำนวนโรลไว้ในเครื่อง (อัปเดตจากเซิร์ฟเวอร์เป็นจังหวะ)
    local bagMax, bagCount, bagFams = 1, 0, {}
    local spinsLeft = -1 -- จำนวนโรลคงเหลือจริงจากเซิร์ฟเวอร์ (Spins + Extra), -1 = ยังไม่รู้

    local function bagText()
        local famListText = bagCount > 0 and table.concat(bagFams, ", ") or "None"
        return string.format("%d/%d %s", bagCount, bagMax, famListText)
    end

    -- แบบย่อสำหรับ HUD บนจอ (มีชื่อเฉพาะตอนมีของ)
    local function bagShort()
        if bagCount > 0 then
            return string.format("%d/%d %s", bagCount, bagMax, table.concat(bagFams, ","))
        end
        return string.format("%d/%d", bagCount, bagMax)
    end

    local function refreshBag()
        local ok, data = pcall(function() return GET:InvokeServer("Functions", "Settings", "Blur", "Off") end)
        if ok and type(data) == "table" and type(data.Slots) == "table" then
            bagMax, bagCount, bagFams = getBagInfo(data, _G.TargetSlot)
            -- กันคำนวณ max พลาด: ถ้าของในกระเป๋าเยอะกว่า max ที่คำนวณได้ ให้เชื่อจำนวนของจริง
            if bagCount > bagMax then bagMax = bagCount end
            -- 🎰 ดึงจำนวนโรลจริงจากเซิร์ฟเวอร์: Spins ปกติ + Extra Spins
            local s = type(data.Spins) == "number" and data.Spins or 0
            local e = type(data.Extra) == "number" and data.Extra or 0
            spinsLeft = s + e
            return data
        end
        return nil
    end

    -- 🗑️ ลบตระกูลออกจากกระเป๋าด้วยชื่อ (เทสกับเซิร์ฟเวอร์จริงแล้ว: ส่งชื่อ = true)
    local function deleteFamilyByName(name)
        local ok, res = pcall(function()
            return GET:InvokeServer("Family", "Delete", name)
        end)
        return ok and res == true
    end

    -- 🔄 ซิงค์เลขบนปุ่ม ROLL / PITY ในเกมให้ตรงกับค่าจริงจากเซิร์ฟเวอร์
    -- (ปกติเกมอัปเดตเลขนี้เฉพาะตอนกดปุ่มสุ่มเอง สุ่มผ่าน remote เลขบนจอจะค้างของเก่า)
    local uiRollLabel, uiPityLabel
    local uiScanNext = 0
    local function syncGameUI(total, pity)
        pcall(function()
            local needRoll = not (uiRollLabel and uiRollLabel.Parent)
            local needPity = not (uiPityLabel and uiPityLabel.Parent)
            if (needRoll or needPity) and os.clock() >= uiScanNext then
                uiScanNext = os.clock() + 10 -- สแกนหาป้ายซ้ำไม่เกินทุก 10 วิ กันหน่วง
                for _, dsc in ipairs(interface:GetDescendants()) do
                    if dsc:IsA("TextLabel") then
                        if needRoll and string.match(dsc.Text, "^ROLL %(") then
                            uiRollLabel = dsc
                            needRoll = false
                        elseif needPity and string.find(dsc.Text, "PITY", 1, true) then
                            uiPityLabel = dsc
                            needPity = false
                        end
                        if not needRoll and not needPity then break end
                    end
                end
            end
            if uiRollLabel and uiRollLabel.Parent then
                uiRollLabel.Text = "ROLL (" .. tostring(total) .. ")"
            end
            if uiPityLabel and uiPityLabel.Parent and pity then
                uiPityLabel.Text = "EPIC+ PITY: " .. tostring(pity) .. "/400"
            end
        end)
    end

    local serverData = nil
    local initTries = 0
    while running() and initTries < 10 do
        serverData = refreshBag()
        if serverData then break end
        initTries = initTries + 1
        task.wait(1)
    end

    if not running() then return end

    -- ⚠️ โหลดข้อมูลไม่ได้ = ไปต่อแบบต้นฉบับ (ข้อมูลจะโหลดได้เองหลังเลือก Slot) ห้ามหยุด!
    if not serverData then
        Status("⚠️ ยังโหลดข้อมูลกระเป๋าไม่ได้ ไปต่อก่อน เดี๋ยวลองใหม่หลังเลือก Slot")
    else
        Status(string.format("🎒 Rolls:%d Bag: max=%d, filled=%d, fams=%s", spinsLeft, bagMax, bagCount, table.concat(bagFams, ", ")))

        -- 🛑 ตรวจสอบช่องกระเป๋า (เฉพาะตอนที่มีข้อมูลจริงเท่านั้น ไม่เดาจากข้อมูลว่าง)
        -- (ถ้ามีตระกูลในกระเป๋าครบ 6 ตัวแล้ว = ช่องต้องมีอย่างน้อย 6 อยู่แล้ว ไม่ต้องไป Lobby)
        if bagMax < 6 and bagCount < 6 then
            Status(string.format("Bag %d/%d < 6 slots: Bypassing to Lobby...", bagCount, bagMax))
            GET:InvokeServer("Functions", "Select", _G.TargetSlot)
            task.wait(1.5)
            pcall(function() GET:InvokeServer("Functions", "Teleport", "Lobby") end)
            task.wait(15)
            return
        end

        -- 🧹 เคลียร์เผ่าที่ไม่ได้อยู่ในเป้าหมายออกจากกระเป๋า
        -- (ลบทีละตัวแล้วโหลดกระเป๋าใหม่ทุกครั้ง กันข้อมูลค้าง
        --  ตัวที่ลบไม่สำเร็จจะจดไว้แล้วข้าม ไม่ทิ้งทั้งรอบเพราะพลาดตัวเดียว)
        Status("Clearing non-target families...")
        local failedDeletes = {}
        local clearing = true
        while clearing and running() do
            clearing = false
            for _, fam in ipairs(bagFams) do
                if getPriority(fam) == 9999 and not failedDeletes[fam] then
                    if deleteFamilyByName(fam) then
                        Status("🗑️ ลบ " .. fam .. " ออกจากกระเป๋า")
                    else
                        failedDeletes[fam] = true
                        Status("⚠️ ลบ " .. fam .. " ไม่สำเร็จ ข้ามตัวนี้ไปก่อน")
                    end
                    clearing = true
                    task.wait(0.5)
                    refreshBag()
                    break
                end
            end
        end

        Status(string.format("Ready! Rolls:%d Bag: %s", spinsLeft, bagText()))
    end

    if not running() then return end

    -- ▶️ กดปุ่ม PLAY เข้าสู่หน้า Slot อัตโนมัติ
    pcall(function()
        local titleUiNode = interface:FindFirstChild("Title_Screen")
        if titleUiNode and titleUiNode.Visible then
            local playBtn = titleUiNode:FindFirstChild("Main") and titleUiNode.Main:FindFirstChild("Buttons") and titleUiNode.Main.Buttons:FindFirstChild("Play")
            if playBtn and playBtn.Visible then
                Status("Pressing PLAY button...")
                VIM_Click(playBtn)
                task.wait(1.5)
            end
        end
    end)

    -- ⚡ Anti-AFK (ทำงานเบื้องหลัง ไม่ขัดขวางลูปหลัก)
    task.spawn(function()
        while running() do
            pcall(function()
                if plr and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = plr.Character.HumanoidRootPart
                    hrp.CFrame = hrp.CFrame * CFrame.new(0, 0.01, 0)
                    task.wait(0.1)
                    hrp.CFrame = hrp.CFrame * CFrame.new(0, -0.01, 0)
                end
            end)
            task.wait(30)
        end
    end)

    if not running() then return end
    GET:InvokeServer("Functions", "Select", _G.TargetSlot)
    task.wait(1)

    -- 🔄 ถ้าตอนแรกโหลดข้อมูลกระเป๋าไม่ได้ ลองใหม่หลังเลือก Slot แล้ว (จังหวะนี้มักโหลดติด)
    if not serverData then
        for i = 1, 5 do
            if not running() then return end
            serverData = refreshBag()
            if serverData then
                Status(string.format("🎒 โหลดข้อมูลสำเร็จ! Rolls:%d Bag: %s", spinsLeft, bagText()))
                break
            end
            task.wait(1)
        end
        if not serverData then
            Status("⚠️ ยังโหลดกระเป๋าไม่ได้ สุ่มไปก่อน (จะอัปเดตเองตอนเก็บเผ่า)")
        end
    end

    -- 🛑 ตั๋วหมดตั้งแต่ยังไม่เริ่ม = ไม่ต้องเข้าลูปให้ยิงเปล่า
    -- (โชว์ผลสุ่มล่าสุดของรอบก่อนด้วย ถ้ามีจำไว้)
    if serverData and spinsLeft <= 0 then
        local lastTxt = ""
        local last = _G.VenozLast
        if type(last) == "table" and last.fam then
            lastTxt = string.format(" | ล่าสุดได้: %s (%s)", tostring(last.fam), tostring(last.t or "?"))
        end
        local finalMsg = string.format("🛑 ตั๋วหมดแล้ว (Rolls:%d)%s Bag: %s", spinsLeft, lastTxt, bagText())
        Status(finalMsg)
        setHud("🛑 ตั๋วหมดแล้ว" .. lastTxt .. "  Bag: " .. bagShort())
        _G.AutoRoll = false
        holdFinal(finalMsg)
        return
    end

    -- 🎲 ลูปสุ่มหลัก
    -- ⏱️ เซิร์ฟเวอร์ล็อคช่วงห่างระหว่างโรลไว้ ~3.2 วิ (วัดจริงจากเซิร์ฟเวอร์)
    -- ตั้งยิงทุก 4 วิ เผื่อไว้ให้ชัวร์ ไม่ยิงถี่จนได้ nil เปล่าๆ
    local ROLL_COOLDOWN = 4
    local rollCount = 0
    local failStreak = 0
    while running() do
        local okRoll, results = pcall(function() return {GET:InvokeServer("Family", "Roll")} end)
        if not okRoll then
            failStreak = failStreak + 1
            Status("⚠️ Roll error! ลองใหม่... (" .. failStreak .. ")")
            task.wait(2)
        else
            -- 🎯 Roll ตอบกลับ (เทสจากเซิร์ฟเวอร์จริง): Spins, ExtraSpins, ตระกูล, Pity, ลิสต์อนิเมชั่น
            -- จำนวนโรลที่เหลือจริง = Spins + ExtraSpins
            local spins = type(results[1]) == "number" and results[1] or 0
            local extraSpins = type(results[2]) == "number" and results[2] or 0
            local tickets = spins + extraSpins
            local familyName = results[3]
            local pity = type(results[4]) == "number" and results[4] or 0
            local gotValid = (type(results[1]) == "number" or type(results[2]) == "number")
                and type(familyName) == "string" and familyName ~= ""

            if gotValid then
                failStreak = 0
                rollCount = rollCount + 1
                spinsLeft = tickets
                local prio = getPriority(familyName)

                -- 📡 อัปเดตทันทีหลังสุ่มทุกตา (เรียลไทม์) + ซิงค์เลขบนจอเกมให้ตรง
                Status(string.format("Rolls:%d, Fam:%s, Pity:%d/400 Bag: %s", tickets, familyName, pity, bagText()))
                setHud(string.format("Rolls: %d  |  Fam: %s  |  Bag: %s", tickets, familyName, bagShort()))
                syncGameUI(tickets, pity)
                -- จำผลสุ่มล่าสุดไว้ (อยู่ข้ามการรันซ้ำ ใช้โชว์ตอนตั๋วหมด)
                _G.VenozLast = {fam = familyName, count = rollCount, bag = bagShort(), t = os.date("%H:%M:%S")}

                if prio < 9999 then
                    Status(string.format("✨ เจอเป้าหมาย: %s! กำลังเก็บ... (Rolls:%d)", familyName, tickets))
                    if bagCount < bagMax then
                        task.wait(1.5)
                        local okStore, stored = pcall(function() return GET:InvokeServer("Family", "Store") end)
                        local refreshed = refreshBag()
                        if okStore and stored == true then
                            if not refreshed then
                                -- เซิร์ฟไม่ตอบข้อมูลกระเป๋า: อัปเดตเองไปก่อน กันข้อมูลค้าง
                                table.insert(bagFams, familyName)
                                bagCount = bagCount + 1
                            end
                            Status(string.format("Rolls:%d, Stored:%s Bag: %s", tickets, familyName, bagText()))
                            setHud(string.format("✨ เก็บ %s แล้ว!  Bag: %s", familyName, bagShort()))
                        else
                            Status(string.format("⚠️ เก็บ %s ไม่สำเร็จ! Bag: %s", familyName, bagText()))
                        end
                    else
                        -- กระเป๋าเต็ม: หาเผ่าที่แย่ที่สุดมาแทนที่
                        local worstFam = nil
                        local worstPrio = -1
                        for _, bFam in ipairs(bagFams) do
                            local bPrio = getPriority(bFam)
                            if bPrio > worstPrio then
                                worstPrio = bPrio
                                worstFam = bFam
                            end
                        end
                        if worstFam and prio < worstPrio then
                            task.wait(1)
                            if deleteFamilyByName(worstFam) then
                                task.wait(1)
                                local okStore2, stored2 = pcall(function() return GET:InvokeServer("Family", "Store") end)
                                local refreshed2 = refreshBag()
                                if okStore2 and stored2 == true then
                                    if not refreshed2 then
                                        -- เซิร์ฟไม่ตอบข้อมูลกระเป๋า: แก้ค่าในเครื่องเองให้ตรงกับที่เกิดจริง
                                        for bi, bf in ipairs(bagFams) do
                                            if bf == worstFam then table.remove(bagFams, bi) break end
                                        end
                                        table.insert(bagFams, familyName)
                                    end
                                    Status(string.format("Rolls:%d, Swap:%s->%s Bag: %s", tickets, worstFam, familyName, bagText()))
                                    setHud(string.format("✨ สลับ %s -> %s  Bag: %s", worstFam, familyName, bagShort()))
                                else
                                    Status(string.format("⚠️ ลบ %s แล้วแต่เก็บ %s ไม่สำเร็จ! Bag: %s", worstFam, familyName, bagText()))
                                end
                            else
                                Status("⚠️ ลบ " .. worstFam .. " ไม่สำเร็จ สุ่มต่อ...")
                            end
                        end
                    end
                end

                -- 🛑 เช็คตั๋วหมด (นับจาก Spins + ExtraSpins รวมกัน)
                if tickets <= 0 then
                    local finalMsg = string.format("🛑 ตั๋วหมด! สุ่มไป %d ครั้ง, ล่าสุด:%s Bag: %s", rollCount, tostring(familyName), bagText())
                    Status(finalMsg)
                    setHud(string.format("🛑 ตั๋วหมด! สุ่มไป %d ครั้ง, ล่าสุด:%s  Bag: %s", rollCount, tostring(familyName), bagShort()))
                    _G.AutoRoll = false
                    holdFinal(finalMsg)
                    break
                end
            else
                -- ⏳ ได้ nil = ยังติด cooldown ของเซิร์ฟเวอร์ รอเงียบๆ แล้วลองใหม่ (ไม่ spam log)
                failStreak = failStreak + 1
                if failStreak % 10 == 0 then
                    Status("⏳ รอ cooldown สุ่ม... (พลาด " .. failStreak .. " ครั้งติด)")
                end
                if failStreak >= 30 then
                    -- ติดนานผิดปกติ (~นาทีกว่า): เช็คตั๋วจากเซิร์ฟเวอร์ก่อน (ตั๋วหมด Roll จะตอบ nil ตลอด)
                    Status("🔧 ติดนานผิดปกติ! เช็คตั๋ว + Select Slot ใหม่...")
                    local d = refreshBag()
                    if d and spinsLeft <= 0 then
                        local finalMsg = string.format("🛑 ตั๋วหมด! สุ่มไป %d ครั้ง Bag: %s", rollCount, bagText())
                        Status(finalMsg)
                        setHud(string.format("🛑 ตั๋วหมด! สุ่มไป %d ครั้ง  Bag: %s", rollCount, bagShort()))
                        _G.AutoRoll = false
                        holdFinal(finalMsg)
                        break
                    end
                    pcall(function() GET:InvokeServer("Functions", "Select", _G.TargetSlot) end)
                    failStreak = 0
                end
                task.wait(1)
            end

            if gotValid then
                task.wait(math.max(_G.Delay, ROLL_COOLDOWN))
            end
        end
    end
end

-- 🚀 เริ่มทำงานอัตโนมัติทันที (ไม่มี UI ให้กดแล้ว คุมผ่าน Config อย่างเดียว)
if _G.AutoRoll then
    Status("Auto Roll starting... Slot:" .. _G.TargetSlot)
    task.spawn(StartAutoRoll)
else
    Status("AutoRoll = false in Config. Bot idle.")
end
