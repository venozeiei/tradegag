-- ============================================================
-- 🎭 DISPATCHER: ยิงสคริปต์หลักเข้า Actor ด้วย run_on_actor
-- (executor นี้ต้องรันบน actor ถึงจะเห็น/ยิง remote ได้เสถียร)
-- ============================================================

local roa = run_on_actor or (getgenv and getgenv().run_on_actor)
local ga = getactors or (getgenv and getgenv().getactors)
local ccc = create_comm_channel or (getgenv and getgenv().create_comm_channel)

-- 📦 ส่ง Config จากฝั่งหลักตามเข้าไปใน Actor (คนละ VM กัน getgenv อาจไม่แชร์)
local header = ""
local cfg = getgenv and getgenv().Venoz_Config
if type(cfg) == "table" then
    local fams = {}
    if type(cfg.TargetFamilies) == "table" then
        for _, f in ipairs(cfg.TargetFamilies) do
            table.insert(fams, string.format("%q", tostring(f)))
        end
    end
    -- รายชื่อว่าง = ใช้ค่าเริ่มต้น (ห้ามส่ง {} เข้าไป เดี๋ยวบอทลบเกลี้ยงกระเป๋า)
    if #fams == 0 then
        fams = {'"Helos"', '"Fritz"', '"Ackerman"'}
    end
    -- Delay ต้องเป็นเลขจริงๆ เท่านั้น (inf/nan serialize แล้วพังทั้ง chunk)
    local d = tonumber(cfg.Delay)
    if d == nil or d ~= d or d == math.huge or d == -math.huge then d = 0.5 end
    header = header .. string.format(
        "getgenv().Venoz_Config = {AutoRoll=%s, TargetSlot=%q, TargetFamilies={%s}, Delay=%s}\n",
        tostring(cfg.AutoRoll ~= false),
        tostring(cfg.TargetSlot or "A"),
        table.concat(fams, ","),
        tostring(d)
    )
end

-- 📡 เปิด comm channel ให้ Actor ส่งข้อความสถานะกลับมาให้ Horst
if type(ccc) == "function" then
    local okC, commId, commEvent = pcall(ccc)
    if okC and commId ~= nil and commEvent ~= nil then
        commEvent.Event:Connect(function(msg)
            -- โชว์ log ใน console ฝั่งหลักด้วย (print จากใน actor ไม่ขึ้น console ของ executor)
            print("📢 [Venoz] " .. tostring(msg))
            local f = _G.Horst_SetDescription or (getgenv and getgenv().Horst_SetDescription)
            if type(f) == "function" then pcall(f, tostring(msg)) end
        end)
        if type(commId) == "number" then
            header = header .. ("getgenv().Venoz_CommId = " .. tostring(commId) .. "\n")
        else
            header = header .. string.format("getgenv().Venoz_CommId = %q\n", tostring(commId))
        end
    end
end

local fullSource = header .. MAIN_SOURCE
local launched = false

if type(roa) == "function" and type(ga) == "function" then
    local okA, actors = pcall(ga)
    if okA and type(actors) == "table" and #actors > 0 then
        local okRun = pcall(roa, actors[1], fullSource)
        if okRun then
            launched = true
            print("🎭 [Venoz] Launched on Actor เรียบร้อย!")
        end
    end
end

if not launched then
    print("🎭 [Venoz] ไม่มี actor ให้ใช้ - รันแบบปกติ")
    local fn, err = loadstring(fullSource)
    if fn then
        fn()
    else
        warn("[Venoz] Load error: " .. tostring(err))
    end
end
